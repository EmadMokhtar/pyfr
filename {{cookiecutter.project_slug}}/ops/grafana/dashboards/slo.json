              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (job:slo_latency_errors:ratio_rate30d{job=\"$service\"} / 0.001)",
          "legendFormat": "remaining",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "description": "How much of the month's error budget is left. At zero the objective is missed for this window; the number recovers as the window rolls forward.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Availability burn rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "job:slo_availability_errors:ratio_rate1h{job=\"$service\"} / 0.001",
          "legendFormat": "1h",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "job:slo_availability_errors:ratio_rate5m{job=\"$service\"} / 0.001",
          "legendFormat": "5m",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "description": "1.0 means the budget will be exactly spent over 30 days. 14.4 means it is gone in two."
    },
    {
