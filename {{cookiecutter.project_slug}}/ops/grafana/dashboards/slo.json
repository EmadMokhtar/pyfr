        }
      ],
      "description": "1.0 means the budget will be exactly spent over 30 days. 14.4 means it is gone in two."
    },
    {
      "type": "timeseries",
      "title": "30-day trend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99
        },
        "overrides": []
