# Copy to .env for local development. Never commit .env itself.
#
# GENERATED FILE -- do not edit. Every line below comes from
# src/{{ cookiecutter.package_name }}/settings.py. Change a description there and run
# `just config-docs`; `just gates` fails if this file has drifted.


# Every environment variable this service reads, prefixed APP_.
# local prints colourised, human-readable logs. Anything else prints one
# JSON object per line.
APP_ENVIRONMENT=local
# The OpenAPI document's title, and the service.name field on every log
# record.
APP_SERVICE_NAME={{ cookiecutter.project_slug }}
# The port to serve on. Read by just dev, by the container's start command,
# and by the image's health check.
APP_HTTP_PORT={{ cookiecutter.http_port }}

# Logging. Structured JSON everywhere except a local environment.
# The root log level.
APP_LOG__LEVEL=info
# Per-logger overrides, as JSON. Silencing a chatty library is
# configuration, not a code change.
APP_LOG__LEVELS='{}'
# Field names whose values are replaced by [REDACTED] before a record is
# rendered, as a JSON array. Matched by exact name at any depth, ignoring
# case and treating - and _ alike. Setting this REPLACES the default list
# rather than adding to it.
APP_LOG__REDACT_FIELDS='["access_token","api_key","apikey","authorization","card_number","cookie","cvv","passwd","password","refresh_token","secret","secret_access_key","secret_key","set_cookie","token"]'

# Tracing and metrics. Off by default: nothing starts until enabled is true.
# Turn on traces and metrics. Off by default: with it off the process builds
# no providers, opens no socket and starts no background task.
APP_OTEL__ENABLED=false
# Export logs over OTLP in addition to standard output. Requires
# APP_OTEL__ENABLED.
APP_OTEL__LOGS_ENABLED=false
# Where traces and metrics go, over OTLP/gRPC. Required when
# APP_OTEL__ENABLED is true — enabling the SDK with nowhere to send data
# stops the process at startup rather than dropping every span from a
# background thread.
# APP_OTEL__ENDPOINT=
# Fraction of new traces recorded, 0.0 to 1.0. Sampling is parent-based, so
# a request arriving with a sampled parent is always recorded whatever this
# says.
APP_OTEL__SAMPLE_RATIO=1.0
# How often metrics are pushed. just o11y lowers it to 10000 so panels move
# while you watch.
APP_OTEL__METRIC_EXPORT_INTERVAL_MS=60000
{%- if cookiecutter.database == "postgres" %}

# PostgreSQL. Optional: leave the whole block unset to run in-memory.
# Optional. Uncomment the whole block to enable it; leave it all commented out to run without.
# Where to store orders. Leave it unset to run with no database at all — the
# service starts on an in-memory repository and serves normally.
# APP_DATABASE__DSN=
# Connections held open to PostgreSQL. This is a true ceiling: max_overflow
# is pinned to 0, so an eleventh concurrent checkout waits rather than
# opening a further connection, and gives up after SQLAlchemy's 30-second
# pool_timeout.
# APP_DATABASE__POOL_SIZE=10
# Applied by the server per connection. A statement running longer is
# cancelled, so one pathological query cannot hold a pooled connection
# indefinitely.
# APP_DATABASE__STATEMENT_TIMEOUT_MS=5000
{%- endif %}

# The payment gateway. Optional: leave unset for the in-memory gateway.
# Optional. Uncomment the whole block to enable it; leave it all commented out to run without.
# The payment provider's base URL. Leave it unset to run on the in-memory
# gateway, which authorises everything. just up points it at a local stub.
# APP_PAYMENT__BASE_URL=
# Sent as a bearer token. SecretStr, so it cannot reach a log line or a
# traceback by accident — it always prints as a row of asterisks, never the
# real value.
# APP_PAYMENT__API_KEY=
# Attempts, not retries: 3 means one call and two further tries.
# APP_PAYMENT__RETRY_ATTEMPTS=3
# Wait before the first retry. Backs off from here.
# APP_PAYMENT__RETRY_INITIAL_WAIT_SECONDS=0.1
# The backoff's ceiling before jitter. stamina adds up to a further second
# of random jitter on top (wait_jitter, fixed, not configured by this
# variable), and the whole retry loop separately stops at a fixed 45-second
# wall-clock budget regardless of this value — see the payment gateway's
# infrastructure/http/payment_gateway.py.
# APP_PAYMENT__RETRY_MAX_WAIT_SECONDS=2.0
# Consecutive failures before the circuit opens.
# APP_PAYMENT__BREAKER_FAILURE_THRESHOLD=5
# How long the circuit stays open before admitting one probe.
# APP_PAYMENT__BREAKER_RESET_AFTER_SECONDS=30.0

# The outbound HTTP client used to call the payment gateway.
# Optional. Uncomment the whole block to enable it; leave it all commented out to run without.
# How long to wait for the TCP/TLS handshake.
# APP_PAYMENT__HTTP__CONNECT_TIMEOUT_SECONDS=2.0
# How long to wait for a response once the request is sent. Never retried on
# expiry — see Outbound HTTP calls.
# APP_PAYMENT__HTTP__READ_TIMEOUT_SECONDS=5.0
# How long to wait while sending the request body.
# APP_PAYMENT__HTTP__WRITE_TIMEOUT_SECONDS=5.0
# How long to wait for a free connection from this client's own pool, before
# any socket to the gateway opens.
# APP_PAYMENT__HTTP__POOL_TIMEOUT_SECONDS=1.0
# The connection pool's ceiling.
# APP_PAYMENT__HTTP__MAX_CONNECTIONS=20
# Idle connections kept open for reuse.
# APP_PAYMENT__HTTP__MAX_KEEPALIVE_CONNECTIONS=10
{%- if cookiecutter.cache == "redis" %}

# Redis. Optional: leave the whole block unset to run with no cache.
# Optional. Uncomment the whole block to enable it; leave it all commented out to run without.
# Where the order cache lives. Leave it unset to run with no cache at all —
# the service reads and writes the order repository directly. See
# CachedOrderRepository.
# APP_CACHE__DSN=
# How long a cached order stays valid. A safety net, not the primary
# invalidation path — saving an order deletes its cache entry outright; the
# TTL only bounds how stale a value can get if that delete itself fails.
# APP_CACHE__TTL_SECONDS=300
# Connections held open to Redis.
# APP_CACHE__POOL_SIZE=10
# How long to wait for the connection to Redis. Deliberately sub-second: a
# cache that can stall a request for longer than the database query it is
# trying to avoid has made the service slower than having no cache. redis-py
# treats 0 as "wait forever", not "give up immediately", which is why this
# is > 0 rather than ≥ 0.
# APP_CACHE__CONNECT_TIMEOUT_SECONDS=0.5
# How long to wait for a single Redis command. Same reasoning as the connect
# timeout, and the same redis-py 0-means-forever trap.
# APP_CACHE__OPERATION_TIMEOUT_SECONDS=0.5
{%- endif %}

# S3-compatible object storage. Optional: leave unset for no storage.
# Optional. Uncomment the whole block to enable it; leave it all commented out to run without.
# The S3 bucket receipts are stored in. Checked against Amazon's naming rule
# (lowercase, digits, hyphens, dots) at startup, so a typo like a capital
# letter fails as exit 78, not as the first failed PutObject.
# APP_STORAGE__BUCKET=
# Leave it unset for real Amazon S3 — botocore derives the endpoint from the
# region on its own. Set it for everything else — MinIO, Cloudflare R2,
# Ceph, or any other S3-compatible provider. This one field is the whole of
# "one adapter for every provider": there is no provider branch anywhere in
# S3ReceiptStore.
# APP_STORAGE__ENDPOINT_URL=
# Required by botocore's request signing even against a provider, like
# MinIO, that ignores it. us-east-1 is the conventional filler value.
# APP_STORAGE__REGION=us-east-1
# SecretStr, so it cannot reach a log line or a traceback by accident.
# APP_STORAGE__ACCESS_KEY_ID=
# SecretStr, same reasoning.
# APP_STORAGE__SECRET_ACCESS_KEY=
# How long to wait for the connection to the storage endpoint.
# APP_STORAGE__CONNECT_TIMEOUT_SECONDS=2.0
# How long to wait for a response once the request is sent.
# APP_STORAGE__READ_TIMEOUT_SECONDS=5.0
