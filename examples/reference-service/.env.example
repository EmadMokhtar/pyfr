# Copy to .env for local development. Never commit .env itself.

APP_ENVIRONMENT=local
APP_SERVICE_NAME=reference-service
APP_HTTP_PORT=8000

# Root log level: debug | info | warning | error | critical
APP_LOG__LEVEL=info
# Per-logger overrides as JSON.
APP_LOG__LEVELS={}

# OpenTelemetry arrives in M2. Standard output is the source of truth for
# logs; enabling OTLP log export in production alongside a platform log
# agent doubles ingest volume and cost.
APP_OTEL__ENABLED=false
APP_OTEL__LOGS_ENABLED=false
# Unset by default. The OTLP collector endpoint the exporter would send to.
# APP_OTEL__ENDPOINT=http://localhost:4317

# PostgreSQL. Leave APP_DATABASE__DSN unset to run on the in-memory
# repository with no database at all — the service still starts and serves.
#
# No `+asyncpg` in this URL and no `?sslmode=` on it. golang-migrate uses this
# string verbatim; the application adds the asyncpg driver itself. See the
# comment on DatabaseSettings.dsn in settings.py.
APP_DATABASE__DSN=postgresql://app:secret@localhost:5432/app
APP_DATABASE__POOL_SIZE=10
APP_DATABASE__STATEMENT_TIMEOUT_MS=5000
