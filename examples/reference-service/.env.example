# Copy to .env for local development. Never commit .env itself.

APP_ENVIRONMENT=local
APP_SERVICE_NAME=reference-service
APP_HTTP_PORT=8000

# Root log level: debug | info | warning | error | critical
APP_LOG__LEVEL=info
# Per-logger overrides as JSON.
APP_LOG__LEVELS={}

# OpenTelemetry arrives in M2. Standard output is the source of truth for
# logs; enabling OTLP log export in production alongside a platform log
# agent doubles ingest volume and cost.
APP_OTEL__ENABLED=false
APP_OTEL__LOGS_ENABLED=false
# Unset by default. The OTLP collector endpoint the exporter would send to.
# APP_OTEL__ENDPOINT=http://localhost:4317

# PostgreSQL. Leave the whole APP_DATABASE__* block below commented out to
# run on the in-memory repository with no database at all — the service
# still starts and serves. Commented out by default, like
# APP_OTEL__ENDPOINT above: `just dev` sources this same file
# (dotenv-load := true in the justfile), so an uncommented DSN with no
# PostgreSQL actually listening would silently switch `just dev` onto the
# PostgreSQL adapter and 500 on the very first order — the wrong first-run
# experience for a value most new readers have not started a database for
# yet. Uncomment the whole block once a database is reachable at this URL —
# `just up` provides one without needing this variable set at all.
#
# All three lines move together, not just the DSN: `database` is optional
# (settings.py's Settings.database: DatabaseSettings | None = None) only
# when NO APP_DATABASE__* variable is present at all. pydantic-settings
# builds the nested DatabaseSettings the moment ANY of its keys is set in
# the environment — so POOL_SIZE and STATEMENT_TIMEOUT_MS left uncommented
# while only DSN is commented out does not fall back to the in-memory
# repository; it fails settings validation entirely, `dsn` reported
# "Field required", because the partially-built DatabaseSettings is
# missing its one required field. Confirmed directly: `.env` with exactly
# that shape (DSN alone commented out) made `load_settings()` exit 78 for
# a missing `database.dsn`, not select the in-memory adapter.
#
# This is read by the APPLICATION only, never by golang-migrate: `just up`'s
# migrate service and every `just migrate-*` recipe carry their own
# hardcoded URL in compose.yaml. Store DSN WITHOUT `+asyncpg` (the
# application adds the driver itself) and WITHOUT `?sslmode=` (asyncpg does
# not understand it, and DatabaseSettings.dsn in settings.py rejects it at
# startup). See the comment on DatabaseSettings.dsn for the full reasoning.
# APP_DATABASE__DSN=postgresql://app:secret@localhost:5432/app
# APP_DATABASE__POOL_SIZE=10
# APP_DATABASE__STATEMENT_TIMEOUT_MS=5000
