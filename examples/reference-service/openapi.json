{
  "components": {
    "schemas": {
      "LivenessResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "MoneyOut": {
        "properties": {
          "amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "MoneyOut",
        "type": "object"
      },
      "OrderLineIn": {
        "properties": {
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "quantity": {
            "exclusiveMinimum": 0.0,
            "maximum": 2147483647.0,
            "title": "Quantity",
            "type": "integer"
          },
          "sku": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Sku",
            "type": "string"
          },
          "unit_amount": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "title": "Unit Amount"
          }
        },
        "required": [
          "sku",
          "quantity",
          "unit_amount",
          "currency"
        ],
        "title": "OrderLineIn",
        "type": "object"
      },
      "OrderLineOut": {
        "properties": {
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "subtotal": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "unit_price": {
            "$ref": "#/components/schemas/MoneyOut"
          }
        },
        "required": [
          "sku",
          "quantity",
          "unit_price",
          "subtotal"
        ],
        "title": "OrderLineOut",
        "type": "object"
      },
      "OrderResponse": {
        "properties": {
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLineOut"
            },
            "title": "Lines",
            "type": "array"
          },
          "total": {
            "$ref": "#/components/schemas/MoneyOut"
          }
        },
        "required": [
          "id",
          "customer_id",
          "lines",
          "total"
        ],
        "title": "OrderResponse",
        "type": "object"
      },
      "PlaceOrderRequest": {
        "properties": {
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLineIn"
            },
            "minItems": 1,
            "title": "Lines",
            "type": "array"
          }
        },
        "required": [
          "customer_id",
          "lines"
        ],
        "title": "PlaceOrderRequest",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
